{
  "version": 2,
  "regions": [
    "sin1"
  ],
  "builds": [
    {
      "src": "apps/api/src/main.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/v1/(.*)",
      "dest": "apps/api/src/main.ts"
    },
    {
      "src": "/(.*)",
      "dest": "apps/api/src/main.ts"
    }
  ]
}