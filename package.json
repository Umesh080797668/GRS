{
  "name": "grs-monorepo",
  "version": "2.0.2",
  "private": true,
  "description": "Global Research & Survey App (GRS) Monorepo",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "pnpm --filter api run lint --if-present",
    "test": "pnpm --filter api test --if-present",
    "test:e2e": "pnpm --filter api run test:e2e --if-present",
    "build": "pnpm --filter api run build --if-present",
    "ci:local": "bash scripts/ci.sh",
    "release": "bash scripts/release.sh",
    "mobile:build": "cd apps/mobile && flutter build apk --release --dart-define-from-file=.env"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": "^8.0.0",
      "multer": "^2.5.0",
      "zod": "^4.6.0",
      "js-yaml": "^5.4.1",
      "raw-body": "2.5.3",
      "jose": "^6.2.15"
    }
  }
}