{
  "name": "grs-monorepo",
  "version": "1.1.0",
  "private": true,
  "description": "Global Research & Survey App (GRS) Monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "lint": "npm --prefix apps/api run lint --if-present",
    "test": "npm --prefix apps/api test --if-present",
    "test:e2e": "npm --prefix apps/api run test:e2e --if-present",
    "build": "npm --prefix apps/api run build --if-present",
    "ci:local": "bash scripts/ci.sh",
    "release": "bash scripts/release.sh",
    "mobile:build": "cd apps/mobile && flutter build apk --release --dart-define-from-file=.env"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}