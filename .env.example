# GRS (Global Research & Survey App) Environment Variables Template
# Copy this file to .env for local development. Never commit real credentials.

# -----------------------------------------------------------------------------
# NestJS Backend API Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Database Connections (Supabase PostgreSQL)
# DIRECT_URL is used exclusively by Prisma migrations (direct connection)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"
# DATABASE_URL connects via Supabase Connection Pooler (PgBouncer transaction mode)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Authentication & JWT Configuration
JWT_ACCESS_SECRET="generate-a-secure-256-bit-secret-here-for-access-tokens"
JWT_REFRESH_SECRET="generate-a-separate-secure-256-bit-secret-here-for-refresh-tokens"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
INITIAL_PASSWORD_TTL_DAYS=30

# Supabase Server Integration
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# CRITICAL: SUPABASE_SERVICE_ROLE_KEY is used exclusively on the server for admin tasks/storage. NEVER expose to apps.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Email Service Configuration (Spike S6 / Provider)
# Options: SMTP URL or provider API key
SMTP_URL="smtp://user:pass@smtp.mailtrap.io:2525"
EMAIL_FROM="no-reply@grs.gov.lk"

# Sentry Error Reporting (PII scrubbed)
SENTRY_DSN=""

# Mobile & App Version Gate (Appendix C)
ANDROID_MIN_VERSION="1.0.0"

# Sync Pacing Parameters (Section 8.5)
SYNC_JITTER_MAX_SECONDS=120
SYNC_BATCH_MAX=50

# -----------------------------------------------------------------------------
# Flutter Client / Dashboard Configuration
# -----------------------------------------------------------------------------
API_BASE_URL="http://localhost:3000/v1"
