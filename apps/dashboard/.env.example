# GRS Web Dashboard Environment Variables Template
# Safe for client distribution (Invariant 5 compliant: NO SERVICE ROLE KEYS)

# NestJS Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0
API_BASE_URL=http://localhost:3000

# Supabase Project Configuration (Public Anon Key only)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Sentry Error Reporting (PII scrubbed)
SENTRY_DSN=
